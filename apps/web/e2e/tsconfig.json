{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES2022"],
    "types": ["node"]
  },
  "include": ["./**/*.ts", "./**/*.mjs", "../playwright.config.ts"]
}
