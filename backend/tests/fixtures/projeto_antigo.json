  "segments": [
   {
    "id": "seg_old0",
    "speaker": "narrator",
    "role": "hook",
    "chapter": null,
    "text": {
     "pt-BR": "Em 2013 um jogo vendeu 475 milhões de cópias e ninguém esperava isso."
    },
    "locked": false
   },
   {
    "id": "seg_old1",
    "speaker": "narrator",
    "role": "body",
    "chapter": null,
    "text": {
     "pt-BR": "A cidade inteira foi desenhada a partir de fotos reais de Los Angeles e de Miami."
    },
    "locked": false
   },
   {
    "id": "seg_old2",
    "speaker": "narrator",
    "role": "chapter",
    "chapter": null,
    "text": {
     "pt-BR": "Capítulo dois: o segredo do mapa que ninguém percebeu na primeira vez."
    },
    "locked": false
   },
   {
    "id": "seg_old3",
    "speaker": "narrator",
    "role": "body",
    "chapter": null,
    "text": {
     "pt-BR": "Os jogadores acharam 3 cidades escondidas e uma delas tinha 12 prédios iguais."
    },
    "locked": false
   },
   {
    "id": "seg_old4",
    "speaker": "narrator",
    "role": "cta",
    "chapter": null,
    "text": {
     "pt-BR": "Se você gostou, se inscreva e conta nos comentários qual é o próximo jogo."
    },
    "locked": false
   }
  ],
